---
import '../styles/global.css';
import { contributions } from '../lib/github';

// Rendered on the server (cached for an hour; see astro.config.mjs) so the
// GitHub heatmap stays current.
export const prerender = false;

const site = 'https://www.nikunjmore.com';
const github = 'NikunjMore';
const description =
  'UC Berkeley Haas + Stats + Data Science student who builds AI products. Looking for a Spring or Summer 2027 product management internship.';

// Letters are split so each one can hop on hover.
const letters = (word: string) => [...word];

// The contribution calendar, or null if GitHub didn't answer.
const calendar = await contributions(github);
const utc = (date: string) => new Date(`${date}T00:00:00Z`);
const weekday = (date: string) => utc(date).getUTCDay();

// The heatmap starts here (GitHub gives the last year; once that's shorter
// than the time since this date, it simply shows the whole year).
const from = '2026-03-01';
const weeks = (calendar?.weeks ?? []).map((week) => week.filter((d) => d.date >= from)).filter((week) => week.length);

// Days drawn in color instead of grey, keyed in the legend. Edit freely.
const kinds = {
  haas: 'Accepted into Haas',
  award: 'Nationals: 2nd in accounting, 8th in impromptu speaking',
  deanza: 'Last day at De Anza',
  yc: 'Attended YC Startup School',
  berkeley: 'First day at Berkeley',
};
const events: Record<string, keyof typeof kinds> = {
  '2026-04-17': 'haas',
  '2026-06-08': 'award',
  '2026-06-26': 'deanza',
  '2026-07-25': 'yc',
  '2026-07-26': 'yc',
  '2026-08-26': 'berkeley',
};
// Only key the colors that are on screen, in date order.
const shownDates = new Set(weeks.flat().map((d) => d.date));
const keys = [...new Set(Object.keys(events).sort().filter((d) => shownDates.has(d)).map((d) => events[d]))];

// A bracket over a stretch of weeks, labeled above the month names.
const stretch = { from: '2026-04-01', to: '2026-04-30', label: 'Self-reflection: finance \u2192 PM' };
const stretchWeeks = weeks.flatMap((week, w) => (week.some((d) => stretch.from <= d.date && d.date <= stretch.to) ? [w] : []));

// Month names over the first week of each month, as on GitHub. A label with
// no room (crowded by the next one, or at the right edge) is dropped.
const monthName = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
const weekCount = weeks.length;
const months = weeks
  .map((week, w, all) => ({ w, month: utc(week[0].date).getUTCMonth(), prev: w ? utc(all[w - 1][0].date).getUTCMonth() : -1, date: week[0].date }))
  .filter((m) => m.month !== m.prev)
  .filter((m, i, ls) => !(ls[i + 1] && ls[i + 1].w - m.w < 3) && m.w <= weekCount - 3)
  .map((m) => ({ w: m.w, name: monthName.format(utc(m.date)) }));

// A note under the week the heatmap lights up: my first contribution, the
// day I found Claude Code in the terminal. It points at whichever column
// holds that date and drops off once the date leaves the range shown.
const discovered = '2026-04-27';
const noteWeek = weeks.findIndex((week) => week[0].date <= discovered && discovered <= week[week.length - 1].date);
// The label runs toward whichever side has more room.
const noteLeft = noteWeek >= 0 && (noteWeek + 0.5) / weekCount > 0.5;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>I'm Nikunj More</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}/`} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />

    <meta property="og:title" content="Nikunj More" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${site}/opengraph-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />

    {/* Hold the page for the intro (src/scripts/intro.ts) before the first
         paint. Skipped for reduced motion; released after 4s no matter what. */}
    <script is:inline>
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var html = document.documentElement;
        html.classList.add('intro');
        setTimeout(function () { html.classList.remove('intro'); }, 4000);
      })();
    </script>
  </head>

  <body>
    <header class="top">
      <div class="strip">
        <span>Berkeley Haas + Stats + DS '28</span>
        <span class="ticks" aria-hidden="true"></span>
        <span>Bay Area, CA</span>
      </div>
      <h1 class="name">
        <span class="sr">Nikunj More</span>
        <span class="word" aria-hidden="true">{letters('Nikunj').map((ch) => <span class="ltr"><span class="base">{ch}</span></span>)}</span>
        <span class="dot" aria-hidden="true"></span>
        <span class="word" aria-hidden="true">{letters('More').map((ch) => <span class="ltr"><span class="base">{ch}</span></span>)}</span>
      </h1>
      <div class="strip band" aria-hidden="true">
        <span class="ticks"></span>
      </div>
    </header>

    <section class="room" id="room" aria-label="About Nikunj">
      <svg class="lines" aria-hidden="true"><path></path></svg>

      <div class="box" id="box">
        <div class="tab" data-reveal><span>01</span><span>About</span><span>/04</span></div>
        {/* Keep each link on the same line as the words around it: Astro
             drops a line break that sits right next to a tag, which glues
             the link to its neighbours. */}
        <dl class="cell prose times">
          <dt>Past</dt>
          <dd>
            <p>
              While at <a href="https://www.deanza.edu/">De Anza</a>, I (basically) finished associate degrees in Statistics,
              Math, Accounting, Economics, and Business.
            </p>
            <p><strong>Along the way&hellip;</strong></p>
            <ul class="wins">
              <li>As <a href="https://adiom.io/">Adiom</a>'s PM intern, my A/B tests <strong>3x'ed</strong> client conversion.</li>
              <li>My AI system cut lead times in my family's business from <strong>4 days to 1</strong>.</li>
              <li>I grew <a href="https://www.deanza.edu/dasg/">De Anza's student government</a> budget by <strong>$160,000</strong> a year.</li>
              <li>I co-founded PeerPrep, a tutoring group, and grew it to <strong>175+</strong> families.</li>
            </ul>
          </dd>
          <dt>Present</dt>
          <dd>
            <p>I study Business, Statistics, and Data Science at <a href="https://www.berkeley.edu/">UC Berkeley</a>.</p>
            <p>
              I'm building The Insight Company of California, a set of model-agnostic productivity
              apps that run on local AI models.
            </p>
            <p>
              I'm getting caught up on world models, specifically <a href="https://ai.meta.com/blog/v-jepa-yann-lecun-ai-model-video-joint-embedding-predictive-architecture/">JEPA</a>. Some of my
              work on pretraining optimization has been recognized by <a href="https://arxiv.org/abs/2506.09985">AI at Meta</a>.
            </p>
            <p>
              In my free time, I go bouldering and train for the Berkeley Half Marathon. I recover
              with home-cooked meals and a Coke Zero.
            </p>
          </dd>
          <dt>Future</dt>
          <dd>
            <p>
              I want to work as an AI product manager: deciding what users need and having the
              agency to make it a reality.
            </p>
            <p>Eventually, I want to build a company around world models&hellip;</p>
            <p>&hellip;and then keep bees and make fragrances in my free time.</p>
          </dd>
        </dl>

        {/* GitHub contributions since March, laid out like the profile page: a
             week per column, months on top, Mon/Wed/Fri down the side, and five
             shades from faint to full ink (grey to white in dark mode). A few
             days are drawn in color for milestones, keyed under the legend. */}
        <div class="tab" data-reveal><span>02</span><span>GitHub + milestones</span><span>/04</span></div>
        {calendar ? (
          <div class="cell heat" data-reveal>
            <p class="heat-head">
              <a class="heat-total" href={`https://github.com/${github}`}><span data-to={calendar.total}>{calendar.total}</span> contributions in the last year &#8599;</a>
              <span class="heat-day" aria-hidden="true"></span>
            </p>
            <div class="cal" style={`--weeks:${weekCount}`}>
              {stretchWeeks.length > 0 && (
                <div class="stretch">
                  <span class="stretch-mark" style={`grid-column:${stretchWeeks[0] + 1} / ${stretchWeeks[stretchWeeks.length - 1] + 2}`}>
                    <span class="stretch-text">{stretch.label}</span>
                  </span>
                </div>
              )}
              <div class="months" aria-hidden="true">
                {months.map((m) => <span style={`grid-column:${m.w + 1}`}>{m.name}</span>)}
              </div>
              <div class="wkdays" aria-hidden="true"><span style="grid-row:2">Mon</span><span style="grid-row:4">Wed</span><span style="grid-row:6">Fri</span></div>
              <div class="days" aria-hidden="true">
                {weeks.map((week, w) => (
                  <div class="week" style={`--w:${w}`}>
                    {week.map((day, i) => (
                      <span
                        class={`sq l${day.level}${events[day.date] ? ` ev-${events[day.date]}` : ''}`}
                        data-c={day.count}
                        data-d={day.date}
                        data-e={events[day.date] ? kinds[events[day.date]] : undefined}
                        style={w === 0 && i === 0 && weekday(day.date) ? `grid-row:${weekday(day.date) + 1}` : undefined}
                      ></span>
                    ))}
                  </div>
                ))}
              </div>
              {noteWeek >= 0 && (
                <div class="note">
                  <span class={`note-mark${noteLeft ? ' to-left' : ''}`} style={`grid-column:${noteWeek + 1};--w:${noteWeek}`}>
                    <svg viewBox="0 0 14 22" aria-hidden="true"><path d={noteLeft ? 'M7 1V17H0' : 'M7 1V17H14'} /><path d="M4 5L7 1L10 5" /></svg>
                    <span class="note-text">Discovered terminal Claude Code</span>
                  </span>
                </div>
              )}
            </div>
            <p class="heat-legend" aria-hidden="true">
              Less <span class="sq l0"></span><span class="sq l1"></span><span class="sq l2"></span><span class="sq l3"></span><span class="sq l4"></span> More
            </p>
            {keys.length > 0 && (
              <ul class="keys">
                {keys.map((k) => <li><span class={`sq ev-${k}`}></span>{kinds[k]}</li>)}
              </ul>
            )}
          </div>
        ) : (
          <div class="cell heat">
            <p class="heat-head"><a href={`https://github.com/${github}`}>See what I'm building on GitHub &#8599;</a></p>
          </div>
        )}

        <div class="tab" data-reveal><span>03</span><span>Looking for</span><span>/04</span></div>
        <div class="cell prose" data-reveal>
          <p>
            I'm looking for a Spring or Summer 2027 PM internship where (ideally) I'm given a goal and the
            freedom to choose how to reach it.
          </p>
        </div>

        <div class="tab" data-reveal><span>04</span><span>Where to find me</span><span>/04</span></div>
        <!-- Icons: Lucide (lucide.dev), ISC License -->
        <nav class="find" id="contact" aria-label="Where to find me" data-reveal>
          <a href="mailto:nikunj.more@berkeley.edu" aria-label="Email nikunj.more@berkeley.edu" title="nikunj.more@berkeley.edu">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" /><rect x="2" y="4" width="20" height="16" rx="2" /></svg>
          </a>
          <a href="tel:+16508809285" aria-label="Call or text (650) 880-9285" title="(650) 880-9285">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" /></svg>
          </a>
          <a href={`https://github.com/${github}`} aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
          </a>
          <a href="https://www.linkedin.com/in/nikunj-more/" aria-label="LinkedIn" title="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></svg>
          </a>
        </nav>
      </div>
    </section>

    {/* Place the box before the first paint, so it doesn't jump when the
         main script loads. Same formula as roomProgress/roomDrift in room.ts. */}
    <script is:inline>
      (function () {
        var room = document.getElementById('room');
        if (!room || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var vh = innerHeight;
        var h = room.clientHeight;
        var top = room.getBoundingClientRect().top + scrollY;
        var p = Math.min(1, Math.max(0, (scrollY + vh - top) / (h + vh)));
        room.style.setProperty('--drift', (innerWidth > 767 ? 400 : 200) * (p * 2 - 1) + 'px');
      })();
    </script>

    <footer class="foot">
      <span>&copy; 2026 Nikunj More</span>
      <a href="mailto:nikunj.more@berkeley.edu">nikunj.more@berkeley.edu</a>
    </footer>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
